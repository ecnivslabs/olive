import term

fn describe(k: term.Key) -> str:
    match k:
        Enter:
            return "enter"
        ShiftEnter:
            return "shift+enter"
        Backspace:
            return "backspace"
        Tab:
            return "tab"
        BackTab:
            return "backtab"
        Escape:
            return "escape"
        Up:
            return "up"
        Down:
            return "down"
        Left:
            return "left"
        Right:
            return "right"
        Home:
            return "home"
        End:
            return "end"
        Delete:
            return "delete"
        PageUp:
            return "pageup"
        PageDown:
            return "pagedown"
        Insert:
            return "insert"
        F(n):
            return "f:" + str(n)
        Ctrl(c):
            return "ctrl:" + c
        Mod(m, b):
            return "mod:" + m + ":" + b
        Char(c):
            return "char:" + c
        Resize:
            return "resize"
        Eof:
            return "eof"
        Idle:
            return "idle"
        WheelUp:
            return "wheelup"
        WheelDown:
            return "wheeldown"
        MouseDown(x, y):
            return "mousedown:" + str(x) + ":" + str(y)
        MouseDrag(x, y):
            return "mousedrag:" + str(x) + ":" + str(y)
        MouseUp(x, y):
            return "mouseup:" + str(x) + ":" + str(y)

fn main():
    print(describe(term._decode("enter")))
    print(describe(term._decode("shift+enter")))
    print(describe(term._decode("backspace")))
    print(describe(term._decode("tab")))
    print(describe(term._decode("backtab")))
    print(describe(term._decode("escape")))
    print(describe(term._decode("up")))
    print(describe(term._decode("down")))
    print(describe(term._decode("left")))
    print(describe(term._decode("right")))
    print(describe(term._decode("home")))
    print(describe(term._decode("end")))
    print(describe(term._decode("delete")))
    print(describe(term._decode("pageup")))
    print(describe(term._decode("pagedown")))
    print(describe(term._decode("insert")))
    print(describe(term._decode("f5")))
    print(describe(term._decode("ctrl+up")))
    print(describe(term._decode("resize")))
    print(describe(term._decode("eof")))
    print(describe(term._decode("idle")))
    print(describe(term._decode("wheelup")))
    print(describe(term._decode("wheeldown")))
    print(describe(term._decode("mousedown:10:20")))
    print(describe(term._decode("mousedrag:10:20")))
    print(describe(term._decode("mouseup:10:20")))
    print(describe(term._decode("ctrl+c")))
    print(describe(term._decode("ctrl+a")))
    print(describe(term._decode("x")))
    print(describe(term._decode("Z")))

