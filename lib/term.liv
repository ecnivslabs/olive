import string

fn enable_raw() -> bool:
    return __olive_term_enable_raw() == 1

fn disable_raw() -> bool:
    return __olive_term_disable_raw() == 1

fn enter_alt_screen() -> bool:
    return __olive_term_enter_alt_screen() == 1

fn leave_alt_screen() -> bool:
    return __olive_term_leave_alt_screen() == 1

fn clear() -> bool:
    return __olive_term_clear() == 1

fn begin_sync() -> bool:
    return __olive_term_begin_sync() == 1

fn end_sync() -> bool:
    return __olive_term_end_sync() == 1

fn cursor_hide() -> bool:
    return __olive_term_cursor_hide() == 1

fn cursor_show() -> bool:
    return __olive_term_cursor_show() == 1

fn cursor_move(x: int, y: int) -> bool:
    return __olive_term_cursor_move(x, y) == 1

fn flush() -> bool:
    return __olive_term_flush() == 1

fn write(s: str) -> bool:
    return __olive_term_write(s) == 1

fn cols() -> int:
    return __olive_term_cols()

fn rows() -> int:
    return __olive_term_rows()

fn is_tty() -> bool:
    return __olive_term_is_tty() == 1

fn enable_key_enhancement() -> bool:
    return __olive_term_enable_key_enhancement() == 1

fn disable_key_enhancement() -> bool:
    return __olive_term_disable_key_enhancement() == 1

fn enable_mouse() -> bool:
    return __olive_term_enable_mouse() == 1

fn disable_mouse() -> bool:
    return __olive_term_disable_mouse() == 1

fn clipboard_write(s: str) -> bool:
    return __olive_term_clipboard_write(s) == 1

enum Key:
    Enter
    ShiftEnter
    Backspace
    Tab
    BackTab
    Escape
    Up
    Down
    Left
    Right
    Home
    End
    Delete
    PageUp
    PageDown
    Insert
    F(int)
    Ctrl(str)
    Mod(str, str)
    Char(str)
    Resize
    Eof
    Idle
    WheelUp
    WheelDown
    MouseDown(int, int)
    MouseDrag(int, int)
    MouseUp(int, int)

// Every modifier combo `encode_key` (std_lib/src/term.rs) can prefix onto a
// named key, in the same fixed ctrl+alt+shift order it emits them in.
// Index 0 (no prefix) is the bare key.
const _MOD_PREFIXES = ["", "ctrl+", "alt+", "shift+", "ctrl+alt+", "ctrl+shift+", "alt+shift+", "ctrl+alt+shift+"]
const _MOD_NAMES = ["", "ctrl", "alt", "shift", "ctrl+alt", "ctrl+shift", "alt+shift", "ctrl+alt+shift"]
const _NAMED_BASES = ["up", "down", "left", "right", "home", "end", "delete", "backspace", "tab", "backtab", "escape", "pageup", "pagedown", "insert"]

fn _bare_named(base: str) -> Key:
    if base == "up":
        return Up
    if base == "down":
        return Down
    if base == "left":
        return Left
    if base == "right":
        return Right
    if base == "home":
        return Home
    if base == "end":
        return End
    if base == "delete":
        return Delete
    if base == "backspace":
        return Backspace
    if base == "tab":
        return Tab
    if base == "backtab":
        return BackTab
    if base == "escape":
        return Escape
    if base == "pageup":
        return PageUp
    if base == "pagedown":
        return PageDown
    return Insert

// Matches `tag` against every (modifier prefix) x (named base, including
// f1..f12) combination `encode_key` can produce. A bare match returns the
// dedicated variant (Up, PageDown, F(5), ...); a modified one returns
// Mod(modifier_name, base) -- e.g. Mod("shift", "up"), Mod("ctrl+alt", "f5").
// None if `tag` isn't one of these shapes at all.
fn _named_or_mod(tag: str) -> Key | None:
    let mut mi = 0

    while mi < len(_MOD_PREFIXES):
        let prefix = _MOD_PREFIXES[mi]
        let modname = _MOD_NAMES[mi]

        let mut fi = 1

        while fi <= 12:
            let candidate = prefix + "f" + str(fi)

            if tag == candidate:
                if modname == "":
                    return F(fi)

                return Mod(modname, "f" + str(fi))

            fi = fi + 1

        let mut bi = 0

        while bi < len(_NAMED_BASES):
            let base = _NAMED_BASES[bi]
            let candidate = prefix + base

            if tag == candidate:
                if modname == "":
                    return _bare_named(base)

                return Mod(modname, base)

            bi = bi + 1

        mi = mi + 1

    return None

// A bare printable char is the overwhelmingly common case (every typed
// character while composing a prompt) -- short-circuit it before the
// O(mods x bases) `_named_or_mod` table walk below. Every non-char token
// this fn recognizes is at least 2 bytes ("up", "f1", "ctrl+c", ...), so a
// single-byte tag can only ever be a literal character.
fn _decode(tag: str) -> Key:
    if string.char_count(tag) == 1:
        return Char(tag)
    if tag == "enter":
        return Enter
    if tag == "shift+enter":
        return ShiftEnter
    if tag == "resize":
        return Resize
    if tag == "eof":
        return Eof
    if tag == "idle":
        return Idle
    if tag == "wheelup":
        return WheelUp
    if tag == "wheeldown":
        return WheelDown
    if string.starts_with(tag, "mousedown:"):
        let parts = string.split(tag[10:], ":")
        return MouseDown(int(parts[0]), int(parts[1]))
    if string.starts_with(tag, "mousedrag:"):
        let parts = string.split(tag[10:], ":")
        return MouseDrag(int(parts[0]), int(parts[1]))
    if string.starts_with(tag, "mouseup:"):
        let parts = string.split(tag[8:], ":")
        return MouseUp(int(parts[0]), int(parts[1]))

    let named = _named_or_mod(tag)

    if named != None:
        return named

    if string.starts_with(tag, "ctrl+"):
        return Ctrl(tag[5:])

    return Char(tag)

fn read_key() -> Key:
    return _decode(__olive_term_read_key())

fn read_key_timeout(ms: int) -> Key:
    return _decode(__olive_term_read_key_timeout(ms))
