fn get(url: str) -> str:
    let res = __olive_http_get(url)
    if res == 0:
        return ""
    return res

fn post(url: str, body: str) -> str:
    let res = __olive_http_post(url, body)
    if res == 0:
        return ""
    return res

fn post_json(url: str, body: str) -> str:
    let res = __olive_http_post_json(url, body)
    if res == 0:
        return ""
    return res

fn put(url: str, body: str) -> str:
    let res = __olive_http_put(url, body)
    if res == 0:
        return ""
    return res

fn delete(url: str) -> int:
    return __olive_http_delete(url)

fn status(url: str) -> int:
    return __olive_http_get_status(url)

fn get_with_headers(url: str, headers) -> str:
    let res = __olive_http_get_with_headers(url, headers)
    if res == 0:
        return ""
    return res

fn last_error() -> str:
    return __olive_http_last_error()

fn post_json_async(url: str, body: str) -> int:
    return __olive_http_post_json_async(url, body)

fn post_json_async_headers(url: str, body: str, headers) -> int:
    return __olive_http_post_json_async_headers(url, body, headers)

fn poll(handle: int) -> int:
    return __olive_http_poll(handle)

fn take_result(handle: int) -> str:
    let res = __olive_http_take_result(handle)
    if res == 0:
        return ""
    return res

fn take_error(handle: int) -> str:
    let res = __olive_http_take_error(handle)
    if res == 0:
        return ""
    return res
