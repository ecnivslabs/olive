fn ok(val) -> obj:
    let owned = __olive_relocate_any(val)
    return __olive_result_ok(owned)

fn err(msg: str) -> obj:
    let owned = __olive_relocate_any(msg)
    return __olive_result_err(owned)

fn is_ok(r) -> bool:
    return __olive_result_is_ok(r) == 1

fn is_err(r) -> bool:
    return __olive_result_is_err(r) == 1

fn unwrap(r):
    return __olive_result_unwrap(r)

fn unwrap_err(r) -> str:
    let e = __olive_result_unwrap_err(r)
    if e == 0:
        return ""
    return e

fn unwrap_or(r, default):
    let owned = __olive_relocate_any(default)
    return __olive_result_unwrap_or(r, owned)

fn err_msg(r) -> str:
    let e = __olive_result_err_msg(r)
    if e == 0:
        return ""
    return e
