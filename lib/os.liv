import process

fn getenv(name: str) -> str:
    let val = __olive_env_get(name)
    if val == 0:
        return ""
    return val

fn setenv(name: str, val: str):
    __olive_env_set(name, val)

fn args() -> list:
    return __olive_os_args()

fn exit(code: int):
    __olive_os_exit(code)

fn exec(cmd: str) -> str:
    let out = process.shell(cmd)

    if out == -1:
        return ""

    return out.stdout

fn exec_status(cmd: str) -> int:
    let out = process.shell(cmd)

    if out == -1:
        return -1

    return out.code
