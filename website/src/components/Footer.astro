---
const base = import.meta.env.BASE_URL;
---
<footer class="footer">
  <div class="footer-left">
    <svg width="16" height="16" viewBox="0 0 26 26" fill="none" aria-hidden="true">
      <path d="M13 8c0-3.5 2-5.5 5-6" stroke="var(--ink-muted)" stroke-width="1.4" stroke-linecap="round"/>
      <ellipse cx="13" cy="16" rx="7" ry="8" stroke="var(--ink-muted)" stroke-width="1.4"/>
    </svg>
    <span>olive</span>
  </div>
  <div class="footer-links">
    <a href={`${base}docs/`}>Docs</a>
    <a href={`${base}registry/`}>Registry</a>
    <a href="https://github.com/ecnivslabs/olive">GitHub</a>
  </div>
</footer>

<style>
  .footer {
    padding: 40px 64px; display: flex; align-items: center; justify-content: space-between;
    border-top: 1px solid var(--border);
  }
  .footer-left {
    display: flex; align-items: center; gap: 11px;
    font-family: var(--font-mono); font-size: 13px; color: var(--ink-muted);
  }
  .footer-links { display: flex; gap: 28px; font-size: 13px; }
  .footer-links a { color: var(--ink-body); }
  @media (max-width: 640px) {
    .footer { padding: 28px 24px; flex-direction: column; gap: 16px; align-items: flex-start; }
  }
</style>
