---
import '../styles/tokens.css';

interface Props {
  title: string;
  description: string;
  active?: 'download' | 'docs' | 'registry';
}
const { title, description, active } = Astro.props;
import Nav from './Nav.astro';
import Footer from './Footer.astro';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} · Olive</title>
  <meta name="description" content={description} />
  <link rel="icon" href="data:," />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
</head>
<body>
  <Nav active={active} />
  <slot />
  <Footer />
</body>
</html>
