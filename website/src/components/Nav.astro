---
interface Props {
  active?: 'get-started' | 'docs' | 'registry';
}
const { active } = Astro.props;
const base = import.meta.env.BASE_URL;
const links = [
  { href: `${base}get-started/`, key: 'get-started', label: 'Get Started' },
  { href: `${base}docs/`, key: 'docs', label: 'Docs' },
  { href: `${base}registry/`, key: 'registry', label: 'Registry' },
];
---
<nav class="nav">
  <a class="brand" href={base}>
    <svg width="24" height="24" viewBox="0 0 26 26" fill="none" aria-hidden="true">
      <path d="M13 8c0-3.5 2-5.5 5-6" stroke="var(--accent)" stroke-width="1.4" stroke-linecap="round"/>
      <ellipse cx="13" cy="16" rx="7" ry="8" stroke="var(--ink)" stroke-width="1.4"/>
    </svg>
    <span class="brand-name">olive</span>
  </a>
  <div class="navlinks">
    {links.map(l => (
      <a href={l.href} class={l.key === active ? 'active' : ''} aria-current={l.key === active ? 'page' : undefined}>{l.label}</a>
    ))}
    <a href="https://github.com/ecnivslabs/olive">GitHub</a>
  </div>
</nav>

<style>
  .nav {
    display: flex; align-items: center; justify-content: space-between;
    padding: 30px 64px; border-bottom: 1px solid var(--border);
  }
  .brand { display: flex; align-items: center; gap: 11px; color: var(--ink); }
  .brand:hover { color: var(--ink); }
  .brand-name { font-family: var(--font-mono); font-size: 16px; }
  .navlinks { display: flex; align-items: center; gap: 36px; font-size: 14px; }
  .navlinks a { color: var(--ink-body); }
  .navlinks a.active { color: var(--accent); }
  @media (max-width: 640px) {
    .nav { padding: 20px 24px; flex-wrap: wrap; gap: 16px; }
    .navlinks { gap: 20px; font-size: 13px; }
  }
</style>
