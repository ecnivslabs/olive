---
import BaseLayout from '../components/BaseLayout.astro';

interface Pod {
  name: string;
  vers: string;
  versionCount: number;
  olive_req?: string;
  deps: { name: string; req: string }[];
  by?: string;
  description?: string;
}

const INDEX_URL = 'https://ecnivslabs.github.io/pit-registry/index.json';

// The registry index is generated by a workflow in pit-registry and served
// from its GitHub Pages. Until that's deployed (or if it's ever unreachable
// at build time), fall back to the one pod actually published today so the
// site still builds and shows real data, not nothing.
let pods: Pod[] = [
  {
    name: 'term',
    vers: '0.1.5',
    versionCount: 6,
    olive_req: '0.42.4',
    deps: [],
    by: 'vinceswu',
    description:
      'Terminal support — raw mode, keyboard and mouse input, cursor control, flicker-free redraws, and clipboard access via OSC 52.',
  },
];

try {
  const res = await fetch(INDEX_URL);
  if (res.ok) {
    const data = await res.json();
    if (Array.isArray(data.pods) && data.pods.length > 0) {
      pods = data.pods;
    }
  }
} catch {
  // Registry index not reachable at build time — keep the fallback above.
}
---
<BaseLayout
  title="Registry"
  description="Search and browse published Olive pods."
  active="registry"
>
  <main>
    <section class="head">
      <p class="eyebrow">package registry</p>
      <h1>{pods.length === 1 ? 'One pod so far.' : `${pods.length} pods so far.`}</h1>
      <div class="search">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="11" cy="11" r="7" stroke="var(--ink-muted)" stroke-width="1.4"/><line x1="16.2" y1="16.2" x2="21" y2="21" stroke="var(--ink-muted)" stroke-width="1.4" stroke-linecap="round"/></svg>
        <input id="pod-search" type="text" placeholder="search pods…" autocomplete="off" />
      </div>
      <p class="note">Every published pod appears here — right now, that's {pods.length === 1 ? 'one' : pods.length}.</p>
    </section>

    <section class="list" id="pod-list">
      {pods.map((pod) => (
        <article class="pod-card" data-name={pod.name.toLowerCase()} data-desc={(pod.description ?? '').toLowerCase()}>
          <div class="pod-top">
            <span class="pod-name">{pod.name}</span>
            <span class="pod-vers">{pod.vers}</span>
          </div>
          {pod.by && <p class="pod-by">by {pod.by}</p>}
          {pod.description && <p class="pod-desc">{pod.description}</p>}
          <div class="pod-meta">
            <span>{pod.versionCount} version{pod.versionCount === 1 ? '' : 's'}</span>
            {pod.olive_req && <span>requires olive ≥ {pod.olive_req}</span>}
            <span>{pod.deps.length === 0 ? 'no dependencies' : `${pod.deps.length} dependenc${pod.deps.length === 1 ? 'y' : 'ies'}`}</span>
          </div>
          <div class="pod-install"><span class="prompt">$</span>pit add {pod.name}</div>
        </article>
      ))}
      <p class="empty" id="pod-empty" hidden>No pods match that search.</p>
    </section>
  </main>
</BaseLayout>

<script>
  const input = document.getElementById('pod-search') as HTMLInputElement | null;
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.pod-card'));
  const empty = document.getElementById('pod-empty');

  input?.addEventListener('input', () => {
    const q = input.value.trim().toLowerCase();
    let visible = 0;
    for (const card of cards) {
      const match = !q || card.dataset.name?.includes(q) || card.dataset.desc?.includes(q);
      card.hidden = !match;
      if (match) visible += 1;
    }
    if (empty) empty.hidden = visible !== 0;
  });
</script>

<style>
  .head { padding: 70px 24px 36px; text-align: center; }
  .eyebrow {
    font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.14em;
    color: var(--accent); text-transform: uppercase; margin: 0 0 20px;
  }
  h1 { font-style: italic; font-size: clamp(30px, 5vw, 48px); margin: 0 0 30px; }
  .search {
    max-width: 520px; margin: 0 auto; display: flex; align-items: center; gap: 10px;
    background: var(--surface); border: 1px solid var(--border); border-radius: 4px; padding: 13px 18px;
  }
  .search input {
    font-family: var(--font-mono); font-size: 14px; color: var(--ink); background: none;
    border: none; outline: none; flex: 1; min-width: 0;
  }
  .search input::placeholder { color: var(--ink-muted); }
  .note { font-size: 13px; color: var(--ink-muted); margin-top: 16px; }

  .list { max-width: 760px; margin: 50px auto 0; padding: 0 24px 100px; display: flex; flex-direction: column; gap: 20px; }
  .pod-card { background: var(--surface); border: 1px solid var(--border); border-radius: 6px; padding: 30px 34px; }
  .pod-top { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 10px; gap: 12px; }
  .pod-name { font-family: var(--font-mono); font-size: 19px; font-weight: 500; }
  .pod-vers { font-family: var(--font-mono); font-size: 13px; color: var(--accent); }
  .pod-by { font-size: 13px; color: var(--ink-muted); margin: 0 0 16px; }
  .pod-desc { font-size: 14.5px; color: var(--ink-body); line-height: 1.65; margin: 0 0 20px; max-width: 60ch; }
  .pod-meta { display: flex; flex-wrap: wrap; gap: 10px 22px; font-family: var(--font-mono); font-size: 12px; color: var(--ink-muted); margin-bottom: 20px; }
  .pod-install {
    background: var(--ink); color: #E9E5D6; border-radius: 4px; padding: 12px 18px;
    font-family: var(--font-mono); font-size: 13px; display: inline-block;
  }
  .pod-install .prompt { color: #A9BA6C; margin-right: 8px; }
  .empty { text-align: center; color: var(--ink-muted); font-size: 14px; padding: 40px 0; }
</style>
