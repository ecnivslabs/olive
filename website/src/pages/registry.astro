---
import BaseLayout from '../components/BaseLayout.astro';
import { fetchPods } from '../lib/registry';

const pods = await fetchPods();
---
<BaseLayout
  title="Registry"
  description="Search and browse published Olive pods."
  active="registry"
>
  <main>
    <section class="head">
      <p class="eyebrow">package registry</p>
      <h1 id="pod-heading">{pods.length === 1 ? 'One pod so far.' : `${pods.length} pods so far.`}</h1>
      <div class="search">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="11" cy="11" r="7" stroke="var(--ink-muted)" stroke-width="1.4"/><line x1="16.2" y1="16.2" x2="21" y2="21" stroke="var(--ink-muted)" stroke-width="1.4" stroke-linecap="round"/></svg>
        <input id="pod-search" type="text" placeholder="search pods…" autocomplete="off" />
      </div>
      <p class="note" id="pod-note">Every published pod appears here. Right now, that's {pods.length === 1 ? 'one' : pods.length}.</p>
    </section>

    <section class="list" id="pod-list">
      <div id="pod-cards">
        {pods.map((pod) => (
          <a class="pod-card" href={`/registry/${pod.name}/`} data-name={pod.name.toLowerCase()} data-desc={(pod.description ?? '').toLowerCase()}>
            <div class="pod-top">
              <span class="pod-name">{pod.name}</span>
              <span class="pod-vers">{pod.vers}</span>
            </div>
            {pod.by && <p class="pod-by">by {pod.by}</p>}
            {pod.description && <p class="pod-desc">{pod.description}</p>}
            <div class="pod-meta">
              <span>{pod.versionCount} version{pod.versionCount === 1 ? '' : 's'}</span>
              {pod.olive_req && <span>requires olive ≥ {pod.olive_req}</span>}
              <span>{pod.deps.length === 0 ? 'no dependencies' : `${pod.deps.length} dependenc${pod.deps.length === 1 ? 'y' : 'ies'}`}</span>
            </div>
          </a>
        ))}
      </div>
      <p class="empty" id="pod-empty" hidden>No pods match that search.</p>
    </section>
  </main>
</BaseLayout>

<script>
  interface Pod {
    name: string;
    vers: string;
    versionCount: number;
    olive_req?: string;
    deps: { name: string; req: string }[];
    by?: string;
    description?: string;
  }

  const INDEX_URL = 'https://ecnivslabs.github.io/pit-registry/index.json';

  const heading = document.getElementById('pod-heading');
  const note = document.getElementById('pod-note');
  const cardsContainer = document.getElementById('pod-cards');
  const listSection = document.getElementById('pod-list');
  const input = document.getElementById('pod-search') as HTMLInputElement | null;
  const empty = document.getElementById('pod-empty');

  function escapeHtml(s: string): string {
    return s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
  }

  function cardHtml(pod: Pod): string {
    const depsText = pod.deps.length === 0 ? 'no dependencies' : `${pod.deps.length} dependenc${pod.deps.length === 1 ? 'y' : 'ies'}`;
    const href = `/registry/${encodeURIComponent(pod.name)}/`;
    return `
      <a class="pod-card" href="${href}" data-name="${escapeHtml(pod.name.toLowerCase())}" data-desc="${escapeHtml((pod.description ?? '').toLowerCase())}">
        <div class="pod-top">
          <span class="pod-name">${escapeHtml(pod.name)}</span>
          <span class="pod-vers">${escapeHtml(pod.vers)}</span>
        </div>
        ${pod.by ? `<p class="pod-by">by ${escapeHtml(pod.by)}</p>` : ''}
        ${pod.description ? `<p class="pod-desc">${escapeHtml(pod.description)}</p>` : ''}
        <div class="pod-meta">
          <span>${pod.versionCount} version${pod.versionCount === 1 ? '' : 's'}</span>
          ${pod.olive_req ? `<span>requires olive &ge; ${escapeHtml(pod.olive_req)}</span>` : ''}
          <span>${depsText}</span>
        </div>
      </a>
    `;
  }

  function renderPods(pods: Pod[]) {
    if (heading) heading.textContent = pods.length === 1 ? 'One pod so far.' : `${pods.length} pods so far.`;
    if (note) note.textContent = `Every published pod appears here. Right now, that's ${pods.length === 1 ? 'one' : pods.length}.`;
    if (cardsContainer) cardsContainer.innerHTML = pods.map(cardHtml).join('');
    applyFilter();
  }

  function applyFilter() {
    const q = (input?.value ?? '').trim().toLowerCase();
    const cards = listSection?.querySelectorAll<HTMLElement>('.pod-card') ?? [];
    let visible = 0;
    for (const card of cards) {
      const match = !q || card.dataset.name?.includes(q) || card.dataset.desc?.includes(q);
      card.hidden = !match;
      if (match) visible += 1;
    }
    if (empty) empty.hidden = visible !== 0;
  }

  input?.addEventListener('input', applyFilter);

  // The page above is the last build's snapshot -- fresh enough to be useful
  // immediately and to work with JS disabled. Revalidate against the live
  // index on every load so a new publish shows up here without anyone having
  // to redeploy the site.
  (async () => {
    try {
      const res = await fetch(INDEX_URL, { cache: 'no-store' });
      if (!res.ok) return;
      const data = await res.json();
      if (Array.isArray(data.pods) && data.pods.length > 0) {
        renderPods(data.pods);
      }
    } catch {
      // Offline, or the index isn't reachable -- keep the build-time snapshot.
    }
  })();
</script>

<style>
  .head { padding: 70px 24px 36px; text-align: center; }
  .eyebrow {
    font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.14em;
    color: var(--accent); text-transform: uppercase; margin: 0 0 20px;
  }
  h1 { font-style: italic; font-size: clamp(30px, 5vw, 48px); margin: 0 0 30px; }
  .search {
    max-width: 520px; margin: 0 auto; display: flex; align-items: center; gap: 10px;
    background: var(--surface); border: 1px solid var(--border); border-radius: 4px; padding: 13px 18px;
  }
  .search input {
    font-family: var(--font-mono); font-size: 14px; color: var(--ink); background: none;
    border: none; outline: none; flex: 1; min-width: 0;
  }
  .search input::placeholder { color: var(--ink-muted); }
  .note { font-size: 13px; color: var(--ink-muted); margin-top: 16px; }

  .list { max-width: 760px; margin: 50px auto 0; padding: 0 24px 100px; display: flex; flex-direction: column; gap: 20px; }
  .pod-card {
    display: block; background: var(--surface); border: 1px solid var(--border); border-radius: 6px;
    padding: 30px 34px; color: inherit; text-decoration: none; transition: border-color 150ms, box-shadow 150ms;
  }
  .pod-card[hidden] { display: none; }
  .pod-card:hover { border-color: var(--accent); box-shadow: 0 6px 20px -8px rgba(25, 22, 16, 0.15); }
  .pod-top { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 10px; gap: 12px; }
  .pod-name { font-family: var(--font-mono); font-size: 19px; font-weight: 500; color: var(--ink); }
  .pod-card:hover .pod-name { color: var(--accent); }
  .pod-vers { font-family: var(--font-mono); font-size: 13px; color: var(--accent); }
  .pod-by { font-size: 13px; color: var(--ink-muted); margin: 0 0 16px; }
  .pod-desc { font-size: 14.5px; color: var(--ink-body); line-height: 1.65; margin: 0 0 20px; max-width: 60ch; }
  .pod-meta { display: flex; flex-wrap: wrap; gap: 10px 22px; font-family: var(--font-mono); font-size: 12px; color: var(--ink-muted); }
  .empty { text-align: center; color: var(--ink-muted); font-size: 14px; padding: 40px 0; }
</style>
