---
import BaseLayout from '../components/BaseLayout.astro';
import InstallCommand from '../components/InstallCommand.astro';

const steps = [
  {
    h: 'Install the toolchain',
    p: '`pit` is the compiler, package manager and project runner in one binary.',
    code: null,
  },
  {
    h: 'Create a project',
    p: 'Scaffolds a `pit.toml` manifest, `src/main.liv`, and a git repository.',
    code: '$ pit new my_app\n$ cd my_app',
  },
  {
    h: 'Open src/main.liv',
    p: 'Every new project starts with a plain entry point.',
    code: 'fn main():\n    print("Hello from Olive!")',
  },
  {
    h: 'Run it',
    p: 'Compiles and executes. Later runs load the cached build and start instantly.',
    code: '$ pit run\nHello from Olive!',
  },
];
---
<BaseLayout
  title="Get Started"
  description="Install the pit toolchain, scaffold a project, and run your first Olive program."
  active="get-started"
>
  <main>
    <section class="head">
      <p class="eyebrow">get started</p>
      <h1>Install, then run.</h1>
      <p>Four commands from a clean shell to a running program.</p>
    </section>

    <section class="steps">
      {steps.map((s, i) => (
        <div class="step">
          <div class="num">{i + 1}</div>
          <div>
            <p class="step-h">{s.h}</p>
            <p class="step-p" set:html={s.p.replace(/`([^`]+)`/g, '<code>$1</code>')} />
            {s.code ? <pre class="code">{s.code}</pre> : <InstallCommand id={`step-${i}-install`} />}
          </div>
        </div>
      ))}
    </section>
  </main>
</BaseLayout>

<style>
  .head { padding: 76px 24px 20px; text-align: center; }
  .eyebrow {
    font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.14em;
    color: var(--accent); text-transform: uppercase; margin: 0 0 20px;
  }
  h1 { font-style: italic; font-size: clamp(34px, 5vw, 50px); margin: 0 0 18px; }
  .head p { font-size: 16px; color: var(--ink-body); max-width: 46ch; margin: 0 auto; line-height: 1.65; }

  .steps { max-width: 760px; margin: 70px auto 0; padding: 0 24px 100px; }
  .step { display: grid; grid-template-columns: 56px 1fr; gap: 26px; padding: 36px 0; border-top: 1px solid var(--border); }
  .step:first-child { border-top: none; }
  .num { font-family: var(--font-display); font-size: 34px; color: var(--accent); }
  .step-h { font-family: var(--font-mono); font-size: 15px; font-weight: 500; margin: 4px 0 10px; }
  .step-p { font-size: 14.5px; color: var(--ink-body); line-height: 1.65; margin: 0 0 16px; }
  .step-p code { font-family: var(--font-mono); background: var(--surface); padding: 1px 5px; border-radius: 3px; font-size: 0.9em; }
  .code {
    background: var(--ink); color: #E9E5D6; border-radius: 4px; padding: 16px 20px;
    font-family: var(--font-mono); font-size: 13px; line-height: 1.7; margin: 0;
    white-space: pre-wrap; word-break: break-word;
  }

  @media (max-width: 560px) {
    .step { grid-template-columns: 36px 1fr; gap: 16px; }
    .num { font-size: 26px; }
  }
</style>
