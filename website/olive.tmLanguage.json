{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "olive",
  "scopeName": "source.olive",
  "fileTypes": ["liv"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#attributes" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#types" },
    { "include": "#functions" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.olive",
          "match": "//.*$"
        }
      ]
    },
    "attributes": {
      "patterns": [
        {
          "name": "meta.attribute.olive",
          "match": "#\\[[^\\]]*\\]"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.interpolated.olive",
          "begin": "f\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.olive",
              "match": "\\\\."
            },
            {
              "name": "meta.interpolation.olive",
              "begin": "\\{",
              "end": "\\}",
              "patterns": [{ "include": "$self" }]
            }
          ]
        },
        {
          "name": "string.quoted.double.olive",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.olive",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.olive",
          "match": "\\b(0[xX][0-9a-fA-F_]+|0[oO][0-7_]+|0[bB][01_]+|[0-9][0-9_]*(\\.[0-9][0-9_]*)?)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.olive",
          "match": "\\b(if|elif|else|for|in|while|match|return|break|continue|pass|try)\\b"
        },
        {
          "name": "keyword.control.async.olive",
          "match": "\\b(async|await)\\b"
        },
        {
          "name": "storage.type.olive",
          "match": "\\b(fn|let|mut|const|struct|enum|trait|impl|type)\\b"
        },
        {
          "name": "keyword.other.import.olive",
          "match": "\\b(import|from|as)\\b"
        },
        {
          "name": "storage.modifier.olive",
          "match": "\\b(pub)\\b"
        },
        {
          "name": "keyword.operator.logical.olive",
          "match": "\\b(and|or|not)\\b"
        },
        {
          "name": "variable.language.self.olive",
          "match": "\\bself\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.olive",
          "match": "\\b(True|False|None)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.builtin.olive",
          "match": "\\b(int|i8|i16|i32|i64|u8|u16|u32|u64|usize|float|f32|f64|str|bool|Any)\\b"
        },
        {
          "name": "support.class.olive",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "match": "\\b(fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.function.olive" },
            "2": { "name": "entity.name.function.olive" }
          }
        },
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "name": "entity.name.function.call.olive"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.olive",
          "match": "->"
        },
        {
          "name": "keyword.operator.assignment.olive",
          "match": "(\\+=|-=|\\*=|/=|==|!=|<=|>=|=)"
        },
        {
          "name": "keyword.operator.other.olive",
          "match": "(\\?|\\||\\+|-|\\*|/|%|<|>|:)"
        }
      ]
    }
  }
}
